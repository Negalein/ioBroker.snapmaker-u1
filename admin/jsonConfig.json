{
	"i18n": true,
	"type": "panel",
	"items": {
		"selectedCameras": {
			"type": "selectSendTo",
			"label": { "de": "Kameras suchen und auswählen", "en": "Discover and select cameras" },
			"command": "discoverCameras",
			"multiple": true,
			"manual": false,
			"noTranslation": true,
			"newLine": true,
			"xs": 12
		},
		"previewEnabled": {
			"type": "checkbox",
			"label": { "de": "Druckvorschau aktivieren", "en": "Enable print preview" },
			"newLine": true,
			"xs": 12
		},
		"host": {
			"type": "text",
			"label": "Moonraker host or IP address",
			"help": "Moonraker host help",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"port": {
			"type": "number",
			"label": "Moonraker port",
			"min": 1,
			"max": 65535,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"firmware": {
			"type": "select",
			"label": "Firmware mode",
			"options": [
				{
					"label": "Auto detect",
					"value": "auto"
				},
				{
					"label": "Original firmware",
					"value": "original"
				},
				{
					"label": "PAXX12 firmware",
					"value": "paxx12"
				}
			],
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"requestTimeout": {
			"type": "number",
			"label": "Request timeout (seconds)",
			"min": 1,
			"max": 120,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"pollInterval": {
			"type": "number",
			"label": "Polling interval (seconds)",
			"min": 5,
			"max": 3600,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"spoolmanEnabled": {
			"type": "checkbox",
			"label": "Enable Spoolman integration",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"spoolmanHost": {
			"type": "text",
			"label": { "de": "Spoolman-IP-Adresse oder Hostname", "en": "Spoolman IP address or hostname" },
			"help": { "de": "Ohne Protokoll und Port. Die aktuellen AFC-/Spoolman-Daten werden über Moonraker gelesen.", "en": "Without protocol or port. Current AFC/Spoolman data is read through Moonraker." },
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"spoolmanPort": {
			"type": "number",
			"label": { "de": "Spoolman-Port", "en": "Spoolman port" },
			"min": 1,
			"max": 65535,
			"xs": 12,
			"md": 6,
			"lg": 4
		}
	}
}
