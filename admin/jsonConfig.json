{
  "i18n": true,
  "type": "panel",
  "items": {
    "selectedCameras": {
      "type": "selectSendTo",
      "label": "Discover and select cameras",
      "command": "discoverCameras",
      "alsoDependsOn": ["host", "port", "selectedCameras"],
      "multiple": true,
      "manual": false,
      "noTranslation": true,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "previewEnabled": {
      "type": "checkbox",
      "label": "Enable print preview",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "host": {
      "type": "text",
      "label": "Moonraker host or IP address",
      "help": "Moonraker host help",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "port": {
      "type": "number",
      "label": "Moonraker port",
      "min": 1,
      "max": 65535,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "firmware": {
      "type": "select",
      "label": "Firmware mode",
      "options": [
        {
          "label": "Auto detect",
          "value": "auto"
        },
        {
          "label": "Original firmware",
          "value": "original"
        },
        {
          "label": "PAXX12 firmware",
          "value": "paxx12"
        }
      ],
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "requestTimeout": {
      "type": "number",
      "label": "Request timeout (seconds)",
      "min": 1,
      "max": 120,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "pollInterval": {
      "type": "number",
      "label": "Polling interval (seconds)",
      "min": 5,
      "max": 3600,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "spoolmanEnabled": {
      "type": "checkbox",
      "label": "Enable Spoolman integration",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 4,
      "xl": 4
    },
    "spoolmanUrl": {
      "type": "text",
      "label": "Spoolman base URL",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanInterval": {
      "type": "number",
      "label": "Spoolman update interval (seconds)",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanWarnLimit": {
      "type": "number",
      "label": "Warning threshold (g)",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanEmptyLimit": {
      "type": "number",
      "label": "Empty threshold (g)",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanWeekdayStart": {
      "type": "number",
      "label": "Weekday warning start hour",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanWeekdayEnd": {
      "type": "number",
      "label": "Weekday warning end hour",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanWeekendStart": {
      "type": "number",
      "label": "Weekend warning start hour",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanWeekendEnd": {
      "type": "number",
      "label": "Weekend warning end hour",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanAlarmInWindow": {
      "type": "checkbox",
      "label": "Restrict empty alarms to warning window",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanTelegramEnabled": {
      "type": "checkbox",
      "label": "Enable Spoolman Telegram notifications",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanTelegramInstance": {
      "type": "text",
      "label": "Telegram instance",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanTelegramUser": {
      "type": "text",
      "label": "Telegram recipient (empty means configured recipients)",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    },
    "spoolmanLegacyMirror": {
      "type": "checkbox",
      "label": "Write legacy VIS states (disable old script first)",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "hidden": "!data.spoolmanEnabled"
    }
  }
}
